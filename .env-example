# Configuración de Base de Datos MySQL
DB_HOST=localhost
DB_NAME=biblioteca_db
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_PORT=3306

# Seguridad JWT (genera uno con: python -c "import secrets; print(secrets.token_urlsafe(32))")
SECRET_KEY_TOKEN=cambia_esta_clave_secreta_por_una_segura_de_32_bytes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Contraseñas iniciales para usuarios semilla
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_BIBLIO_PASSWORD=biblio123

# Protección contra fuerza bruta en login (bloqueo al 3er intento fallido)
LOGIN_MAX_ATTEMPTS=3
LOGIN_LOCKOUT_SECONDS=60
LOGIN_MAX_LOCKOUT_SECONDS=900
LOGIN_LOCKOUT_MULTIPLIER=2.0

# Entorno ('development' habilita /docs y /redoc; 'production' los desactiva)
ENVIRONMENT=development
PORT=8000
